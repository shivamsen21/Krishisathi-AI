# ==============================================================================
# KrishiSathi AI / AgroVision AI — Environment Configuration
# Copy this file to '.env' and fill in your actual credentials.
# ==============================================================================

# Supabase Project Configuration (Optional for local dev mode)
# If left empty, backend runs with in-memory SQLite/dictionary fallback for development.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Authentication Secret
# Used for decoding & verifying session tokens in standalone or fallback mode
JWT_SECRET=your-secure-jwt-secret-here

# Application Environment ('development' or 'production')
APP_ENV=development

# Server Host & Port
HOST=0.0.0.0
PORT=8000
